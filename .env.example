# --- SQLite ---
# En Docker usa /app/data/sablon.sqlite (el directorio debe tener volumen).
SQLITE_DB_PATH=./data/sablon.sqlite
WEB_PORT=8080

# --- Sesión admin (32+ caracteres) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=please-change-me-to-32-chars-minimum-secret

# --- Bootstrap del primer admin (solo se usa si no existe ningún usuario) ---
ADMIN_BOOTSTRAP_EMAIL=admin@sablon.local
ADMIN_BOOTSTRAP_PASSWORD=

# --- Telegram (opcional; si vacío no se notifica) ---
TELEGRAM_BOT_TOKEN=
# Uno o varios chat_id separados por comas (se mantiene TELEGRAM_CHAT_ID por compatibilidad).
TELEGRAM_CHAT_IDS=
TELEGRAM_CHAT_ID=

# --- Build-time (opcional) ---
PUBLIC_SITE_URL=http://localhost:8080
