---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ItemCard from "../components/ItemCard";
import Title from "../components/Title.astro";
import { db, schema } from "../lib/db/client.ts";
import { and, asc, eq, isNull } from "drizzle-orm";

let categories: { slug: string; name: string }[] = [];
let products: any[] = [];

if (db) {
  categories = await db
    .select({ slug: schema.categories.slug, name: schema.categories.name })
    .from(schema.categories)
    .where(and(eq(schema.categories.active, true), isNull(schema.categories.deletedAt)))
    .orderBy(asc(schema.categories.sortOrder), asc(schema.categories.id));

  const rows = await db
    .select({
      id: schema.products.id,
      slug: schema.products.slug,
      name: schema.products.name,
      shortDescription: schema.products.shortDescription,
      priceCents: schema.products.priceCents,
      currency: schema.products.currency,
      artisan: { slug: schema.artisans.slug, name: schema.artisans.name },
      category: { slug: schema.categories.slug, name: schema.categories.name },
    })
    .from(schema.products)
    .innerJoin(schema.artisans, eq(schema.products.artisanId, schema.artisans.id))
    .innerJoin(schema.categories, eq(schema.products.categoryId, schema.categories.id))
    .where(and(
      eq(schema.products.status, 'disponible'),
      eq(schema.products.active, true),
      isNull(schema.products.deletedAt),
      eq(schema.categories.active, true),
      isNull(schema.categories.deletedAt),
      eq(schema.artisans.active, true),
      isNull(schema.artisans.deletedAt),
    ))
    .orderBy(asc(schema.products.sortOrder), asc(schema.products.id));

  const imagesRows = await db
    .select()
    .from(schema.productImages)
    .where(isNull(schema.productImages.deletedAt))
    .orderBy(asc(schema.productImages.productId), asc(schema.productImages.sortOrder));
  const imagesByProduct = new Map<number, typeof imagesRows>();
  for (const img of imagesRows) {
    if (!imagesByProduct.has(img.productId)) imagesByProduct.set(img.productId, []);
    imagesByProduct.get(img.productId)!.push(img);
  }
  products = rows.map((r) => ({
    ...r,
    images: (imagesByProduct.get(r.id) ?? []).map((i) => i.url),
  }));
}

const filterCategories = categories;
const allCategories = [{ id: "all", label: "Todos" }, ...filterCategories.map((c) => ({ id: c.slug, label: c.name }))];
---

<html lang="es">
  <head>
    <BaseHead title="Productos - El Sablón" description="Nuestros productos artesanales" />
  </head>
  <body class="bg-surface-low">
    <main>
      <Header />

      <section class="max-w-6xl mx-auto pt-13 pb-8 px-6 text-center">
        <Title title="Nuestros Productos">
          Descubre nuestra selección de productos artesanales hechos a mano con
          dedicación y pasión. Cada pieza refleja la tradición y el arte de la
          artesanía asturiana.
        </Title>
      </section>

      {filterCategories.length > 0 && (
        <div class="max-w-screen-xl mx-auto px-4 md:px-8 lg:px-12 mb-8">
          <div class="flex flex-wrap gap-2 justify-center">
            {allCategories.map((cat) => (
              <button
                data-filter={cat.id}
                class:list={[
                  "filter-btn px-5 py-2 rounded-full text-sm font-medium transition-colors duration-200 border border-leather/20 text-dark-brown/70 hover:border-leather hover:text-leather",
                  cat.id === "all" ? "active-filter" : "",
                ]}
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>
      )}

      <div
        id="products-grid"
        class="max-w-screen-xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-4 md:px-8 lg:px-12"
      >
        {products.map((producto) => (
          <div data-category={producto.category.slug} class="product-wrapper">
            <ItemCard {...producto} client:visible />
          </div>
        ))}
        {products.length === 0 && (
          <p class="col-span-full text-center text-dark-brown/60 py-12">
            El escaparate se está preparando. Vuelve pronto.
          </p>
        )}
      </div>

      <Footer />
    </main>
  </body>
</html>

<style>
  .filter-btn.active-filter {
    background-color: rgb(93 64 55);
    border-color: rgb(93 64 55);
    color: rgb(250 243 224);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const wrappers = document.querySelectorAll<HTMLElement>(".product-wrapper");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.filter!;

        filterBtns.forEach((b) => b.classList.remove("active-filter"));
        btn.classList.add("active-filter");

        wrappers.forEach((wrapper) => {
          wrapper.style.display =
            cat === "all" || wrapper.dataset.category === cat ? "" : "none";
        });
      });
    });
  });
</script>
