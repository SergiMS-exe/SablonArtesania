---
import AdminShell from "../../../layouts/AdminShell.astro";
import { db, schema } from "../../../lib/db/client.ts";
import { asc } from "drizzle-orm";

if (!db) return Astro.redirect("/admin/login?error=db_unavailable");

const artisans = await db
  .select()
  .from(schema.artisans)
  .orderBy(asc(schema.artisans.sortOrder), asc(schema.artisans.id));
---

<AdminShell title="Artesanos">
  <div class="grid lg:grid-cols-3 gap-6">
    <form id="new-artisan" class="bg-cream p-6 rounded-2xl shadow space-y-3 h-fit">
      <h2 class="text-lg font-title font-bold text-walnut-deep">Nuevo artesano</h2>
      <div>
        <label class="block text-sm font-semibold text-walnut-deep mb-1" for="a-name">Nombre</label>
        <input id="a-name" name="name" required class="w-full px-3 py-2 rounded-xl border border-wood-light bg-surface-low text-sm focus:border-leather focus:outline-none" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-walnut-deep mb-1" for="a-spec">Especialidad</label>
        <input id="a-spec" name="specialty" class="w-full px-3 py-2 rounded-xl border border-wood-light bg-surface-low text-sm focus:border-leather focus:outline-none" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-walnut-deep mb-1" for="a-loc">Ubicación</label>
        <input id="a-loc" name="location" class="w-full px-3 py-2 rounded-xl border border-wood-light bg-surface-low text-sm focus:border-leather focus:outline-none" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-walnut-deep mb-1" for="a-ig">Instagram</label>
        <input id="a-ig" name="instagram" class="w-full px-3 py-2 rounded-xl border border-wood-light bg-surface-low text-sm focus:border-leather focus:outline-none" placeholder="usuario" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-walnut-deep mb-1" for="a-img">URL imagen</label>
        <input id="a-img" name="imageUrl" class="w-full px-3 py-2 rounded-xl border border-wood-light bg-surface-low text-sm focus:border-leather focus:outline-none" placeholder="/logo-marca.webp" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-walnut-deep mb-1" for="a-short">Bio corta</label>
        <textarea id="a-short" name="shortBio" rows="2" class="w-full px-3 py-2 rounded-xl border border-wood-light bg-surface-low text-sm focus:border-leather focus:outline-none"></textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold text-walnut-deep mb-1" for="a-long">Bio larga</label>
        <textarea id="a-long" name="longBio" rows="3" class="w-full px-3 py-2 rounded-xl border border-wood-light bg-surface-low text-sm focus:border-leather focus:outline-none"></textarea>
      </div>
      <button class="w-full bg-leather hover:bg-walnut-deep text-cream py-2.5 rounded-full font-semibold transition-colors">
        Crear
      </button>
    </form>

    <div class="lg:col-span-2 bg-cream p-6 rounded-2xl shadow">
      <h2 class="text-lg font-title font-bold text-walnut-deep mb-4">Listado ({artisans.length})</h2>
      {artisans.length === 0 ? (
        <p class="text-sm text-dark-brown/60">Aún no hay artesanos.</p>
      ) : (
        <ul id="artisan-list" class="divide-y divide-wood-light/40">
          {artisans.map((a) => (
            <li class="py-4 grid grid-cols-1 md:grid-cols-[1fr_auto_auto_auto_auto] gap-3 items-center" data-id={a.id} data-deleted={a.deletedAt ? 'true' : 'false'}>
              <div class="min-w-0">
                <div class="font-semibold text-walnut-deep truncate">{a.name}</div>
                <div class="text-xs text-dark-brown/60 truncate">
                  {a.specialty ?? ""} {a.location ? `· ${a.location}` : ""}
                </div>
                <div class="text-xs text-dark-brown/40">/{a.slug}</div>
                {a.deletedAt && <span class="text-xs bg-red-100 text-red-800 px-2 py-1 rounded-full">Eliminado</span>}
              </div>
              <label class="flex items-center gap-2 text-xs">
                <input type="checkbox" data-active checked={a.active} class="accent-leather" />
                <span>Activo</span>
              </label>
              <input type="number" value={a.sortOrder} data-sort class="w-16 px-2 py-1 text-sm rounded-lg border border-wood-light bg-surface-low" />
              <button data-save class="text-xs bg-leather text-cream px-3 py-1.5 rounded-full">Guardar</button>
              {a.deletedAt ? (
                <button data-restore class="text-xs text-green-800 hover:underline">Restaurar</button>
              ) : (
                <button data-del class="text-xs text-red-700 hover:underline">Eliminar</button>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</AdminShell>

<script>
  const form = document.getElementById("new-artisan") as HTMLFormElement;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload: Record<string, unknown> = {
      name: fd.get("name"),
      specialty: fd.get("specialty") || null,
      location: fd.get("location") || null,
      instagram: fd.get("instagram") || null,
      imageUrl: fd.get("imageUrl") || null,
      shortBio: fd.get("shortBio") || null,
      longBio: fd.get("longBio") || null,
      sortOrder: Number(fd.get("sortOrder") ?? 0),
    };
    const res = await fetch("/api/admin/artisans", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    if (res.ok) location.reload();
    else alert("Error: " + res.status);
  });

  document.querySelectorAll<HTMLLIElement>("#artisan-list li").forEach((li) => {
    const id = li.dataset.id!;
    const activeInput = li.querySelector<HTMLInputElement>("[data-active]")!;
    const sortInput = li.querySelector<HTMLInputElement>("[data-sort]")!;
    li.querySelector<HTMLButtonElement>("[data-save]")?.addEventListener("click", async () => {
      const res = await fetch(`/api/admin/artisans/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          active: activeInput.checked,
          sortOrder: Number(sortInput.value),
        }),
      });
      if (res.ok) {
        const btn = li.querySelector<HTMLButtonElement>("[data-save]")!;
        btn.textContent = "OK";
        btn.classList.add("bg-green-700");
        setTimeout(() => {
          btn.textContent = "Guardar";
          btn.classList.remove("bg-green-700");
        }, 800);
      }
    });
    li.querySelector<HTMLButtonElement>("[data-del]")?.addEventListener("click", async () => {
      if (!confirm("¿Eliminar este artesano del escaparate? Se podrá restaurar después.")) return;
      const res = await fetch(`/api/admin/artisans/${id}`, { method: "DELETE" });
      if (res.ok) location.reload();
      else {
        const err = await res.json().catch(() => ({}));
        alert("No se pudo eliminar: " + (err.message ?? err.error ?? res.status));
      }
    });
    li.querySelector<HTMLButtonElement>("[data-restore]")?.addEventListener("click", async () => {
      const res = await fetch(`/api/admin/artisans/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ deletedAt: null, active: true }),
      });
      if (res.ok) location.reload();
      else alert("No se pudo restaurar el artesano.");
    });
  });
</script>
