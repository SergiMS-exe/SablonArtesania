---
import BaseHead from "../../components/BaseHead.astro";

const url = Astro.url;
const errorParam = url.searchParams.get("error");
const nextParam = url.searchParams.get("next") ?? "/admin";

const errorMessage: Record<string, string> = {
  invalid_credentials: "Email o contraseña incorrectos.",
  missing_credentials: "Rellena email y contraseña.",
};
const errorText = errorParam ? errorMessage[errorParam] ?? "No se pudo iniciar sesión." : null;

if (Astro.locals.user) {
  return Astro.redirect(nextParam);
}
---

<html lang="es">
  <head>
    <BaseHead title="Admin · Iniciar sesión" description="Acceso al panel de administración" />
  </head>
  <body class="bg-surface-low min-h-screen flex items-center justify-center p-6">
    <main class="w-full max-w-md">
      <div class="bg-cream p-8 rounded-2xl shadow">
        <h1 class="text-2xl font-title font-bold text-walnut-deep mb-1 text-center">
          Panel de administración
        </h1>
        <p class="text-sm text-dark-brown/60 text-center mb-6">
          El Sablón · Artesanía
        </p>

        {errorText && (
          <div class="mb-4 p-3 rounded-xl bg-red-100 text-red-800 text-sm text-center font-semibold">
            {errorText}
          </div>
        )}

        <form method="POST" action="/api/auth/login" class="space-y-4">
          <input type="hidden" name="next" value={nextParam} />
          <div>
            <label for="email" class="block text-sm font-semibold text-walnut-deep mb-1">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="username"
              class="w-full px-4 py-3 rounded-xl border border-wood-light bg-surface-low focus:border-leather focus:outline-none transition-colors text-sm"
              placeholder="admin@sablon.local"
            />
          </div>
          <div>
            <label for="password" class="block text-sm font-semibold text-walnut-deep mb-1">Contraseña</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full px-4 py-3 rounded-xl border border-wood-light bg-surface-low focus:border-leather focus:outline-none transition-colors text-sm"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-leather hover:bg-walnut-deep text-cream py-3 rounded-full font-semibold transition-colors duration-200"
          >
            Entrar
          </button>
        </form>
      </div>
    </main>
  </body>
</html>
